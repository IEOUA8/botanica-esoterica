# =============================================================================
# Botánica Esotérica Internacional — Environment Variables
# Development defaults are shown. Override for production.
# NEVER commit .env or .env.production to git.
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev (Docker replica set):
MONGO_URI=mongodb://127.0.0.1:27017/botanica_esoterica?replicaSet=rs0
# Production (MongoDB Atlas):
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/botanica_esoterica

# Set to true to run without a database (in-memory demo data)
DEMO_MODE=false
# Seed demo products/categories on the first local startup
SEED_DEMO_DATA=true

# ── Security ──────────────────────────────────────────────────────────────────
# PRODUCTION: generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters. Rotate if ever exposed.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Admin credentials. In production: strong password ≥12 chars.
ADMIN_EMAIL=admin@botanica.test
ADMIN_PASSWORD=change-this-admin-password
ADMIN_NAME=Administrador

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
# Production: CLIENT_URL=https://botanica.example.com
CLIENT_URL=http://localhost:5173

# ── Proxy ─────────────────────────────────────────────────────────────────────
# Uncomment ONLY when deploying behind a reverse proxy (Nginx, Traefik, Cloudflare)
# TRUST_PROXY=1

# ── Shipping ──────────────────────────────────────────────────────────────────
# Flat shipping rate in COP (0 = free shipping always)
SHIPPING_FLAT_RATE=0
# Orders above this amount (COP) get free shipping (0 = disabled)
FREE_SHIPPING_THRESHOLD=0

# ── WhatsApp ──────────────────────────────────────────────────────────────────
WHATSAPP_NUMBER=573001112233
