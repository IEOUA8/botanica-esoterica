{
  "name": "botanica-internacional",
  "version": "1.0.0",
  "private": true,
  "description": "Tienda online full stack para Botánica Esotérica Internacional.",
  "scripts": {
    "dev": "concurrently -n API,WEB -c green,magenta \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "build": "npm run build --prefix client",
    "start": "npm run start --prefix server",
    "lint": "npm run lint --prefix client",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f mongo"
  },
  "keywords": [
    "ecommerce",
    "react",
    "express",
    "botanica-esoterica"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
